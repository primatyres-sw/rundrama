# Copy to .env.local and fill in from https://www.strava.com/settings/api
# .env.local is gitignored — never commit real credentials.

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Optional. Leave blank and the redirect URI is derived from the incoming
# request, which works for both localhost and Vercel. Set it only when a proxy
# rewrites the origin.
# STRAVA_REDIRECT_URI=
